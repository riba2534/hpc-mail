{
  "name": "@hpc-mail/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --local",
    "test": "node scripts/check-migrations-selftest.mjs && node scripts/check-migrations.mjs && node scripts/check-inject-asset-routes.mjs && node scripts/check-ensure-delivery-queue.mjs && vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "build:assets": "rm -rf dist && cp -R ../web/dist ./dist && node scripts/inject-asset-routes.mjs --check",
    "deploy": "wrangler d1 migrations apply db --remote && node scripts/seed-admin.mjs --if-env && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply hpc-cloud-mail-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply hpc-cloud-mail-db --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@hpc-mail/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "mimetext": "^3.0.28",
    "parse5": "8.0.1",
    "postal-mime": "^4.2.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.4",
    "@cloudflare/workers-types": "^5.20261120.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.164.0"
  }
}
