{
  "name": "@hpc-mail/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "test": "node scripts/check-drop-legacy.mjs && vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "build:assets": "rm -rf dist && cp -R ../web/dist ./dist",
    "deploy": "wrangler d1 migrations apply db --remote && node scripts/seed-admin.mjs --if-env && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply hpc-cloud-mail-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply hpc-cloud-mail-db --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@hpc-mail/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.34",
    "mimetext": "^3.0.28",
    "postal-mime": "^2.7.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.4",
    "@cloudflare/workers-types": "^5.20260714.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}
